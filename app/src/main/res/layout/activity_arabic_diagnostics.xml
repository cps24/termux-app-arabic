<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#300A24">

    <TextView
        android:id="@+id/diagnostics_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/arabic_diagnostics_title"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"
        android:layout_gravity="center_horizontal"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/arabic_diagnostics_sample_tashkeel_title"
                android:textColor="#FFB534"
                android:textStyle="bold"
                android:layout_marginTop="8dp"/>
            <TextView
                android:id="@+id/test_case_tashkeel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:padding="8dp"
                android:background="#4A1E3E"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/arabic_diagnostics_sample_mixed_title"
                android:textColor="#FFB534"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/test_case_mixed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:padding="8dp"
                android:background="#4A1E3E"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/arabic_diagnostics_sample_punctuation_title"
                android:textColor="#FFB534"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/test_case_punctuation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:padding="8dp"
                android:background="#4A1E3E"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/arabic_diagnostics_sample_ligatures_title"
                android:textColor="#FFB534"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/test_case_ligatures"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:padding="8dp"
                android:background="#4A1E3E"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/arabic_diagnostics_info_title"
                android:textColor="#FFB534"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/tv_info_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:padding="8dp"
                android:background="#4A1E3E"
                android:layout_marginBottom="12dp"/>

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btn_copy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/arabic_diagnostics_btn_copy"
        android:textColor="#FFFFFF"
        android:backgroundTint="#FFB534"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btn_back"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/arabic_diagnostics_btn_back"
        android:textColor="#FFFFFF"
        android:backgroundTint="#FFB534"/>
</LinearLayout>
